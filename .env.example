# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project "moba-site": Project Settings > API (or Connect).
# Use the publishable/anon key. NEVER the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: emails the admin when a submission is saved (and is the fallback if saving fails).
VITE_WEB3FORMS_KEY=

# Optional: PesaPal backend for online membership payment (not built yet).
VITE_PAYMENT_API_URL=
