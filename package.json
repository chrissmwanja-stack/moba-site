{
  "name": "moba-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint eslint.config.js src tests scripts vite.config.js playwright.config.js playwright.production.config.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:browser:prod": "playwright test --config=playwright.production.config.js",
    "test:security": "node --test tests/security/anonymous-supabase.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check": "npm run lint && npm run test:unit && npm run check:migrations && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  }
}
